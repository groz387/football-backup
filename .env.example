# Copy to .env and fill locally. Never commit real keys.

# Gemini writes the script in the picked language. Deterministic copy is the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
GEMINI_SCRIPT_MODEL=gemma-4-31b-it

# Optional contextual translator for az / es / ru.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TRANSLATION_PROVIDER=auto
