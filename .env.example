# Copy to .env and fill locally. Never commit real keys.

# Gemini (optional — deterministic script is the fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SCRIPT_MODEL=gemini-2.5-pro

# ElevenLabs v3. Prefer a single key for local; comma-separated list is rotate-ready.
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEYS=
# Optional: one proxy URL per key, same order as ELEVENLABS_API_KEYS
ELEVENLABS_PROXIES=

# Voice: search/use "Liam Callahan - Witty Media Person". Store the id, not only the name.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=Liam Callahan - Witty Media Person
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_STYLE=robust
