# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local scrape / render scratch (regenerable, often huge)
_probe/
_verify/
_verify_video/
_network_hits/
screenshots/
_*.html
_*.json
_*.js
_*.log

# Generated video packages (regenerate with video_pipeline.py)
video_output/

# Runtime-generated recap audio (ffmpeg lavfi / numpy; keep git small)
recap/sfx/*.wav
recap/sfx/.pack_version
recap/sfx/beds/

# Generated growth/SEO posting packs (python -m recap.growth / --write-growth)
output/**/growth/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.cache/
assets/logos/*
!assets/logos/.gitkeep

# Auto-fetched match highlights (regenerable; can be large)
output/**/clips/
output/**/highlights/

# Local operator console
studio/settings.json
studio/jobs/*
!studio/jobs/.gitkeep
